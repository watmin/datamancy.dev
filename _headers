# Cloudflare Pages headers for datamancy.dev.
#
# The grimoire is served as bare, hash-verified markdown — no rendering layer.
# The file IS the artifact. These headers (1) set MIME types so clients see raw
# text exactly as committed, and (2) advertise agent-discovery metadata on every
# response: RFC 8288 Link relations + Content Signals (the HTTP equivalent of
# robots.txt's Content-Signal line).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Signal: search=yes, ai-input=yes, ai-train=yes
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"
  Link: <https://github.com/watmin>; rel="author"

# The grimoire index is the landing page (/ redirects here) — point agents at
# the signed manifest and the skills index from it. Content-Type is NOT declared
# here: the single /*.md rule below owns it. Declaring it twice stacks a
# duplicate `Content-Type` header (Cloudflare concatenates matching rules).
/grimoire/SKILL.md
  Link: </.well-known/mcp/manifest.json>; rel="alternate"; type="application/json"; title="Signed MCP manifest"
  Link: </.well-known/agent-skills/index.json>; rel="alternate"; type="application/json"; title="Agent Skills index"

# ALL markdown, ONE rule. Spell SKILL.md files end in .md; `*` spans path
# separators, so this matches nested <name>/SKILL.md too — as well as the
# grimoire index and the top-level docs (README.md, auth.md). One owner means no
# path ever matches two Content-Type rules and stacks a duplicate header.
/*.md
  Content-Type: text/markdown; charset=utf-8

# Agent-discovery companions
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300
/robots.txt
  Content-Type: text/plain; charset=utf-8
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/webmcp.js
  Content-Type: application/javascript; charset=utf-8

# .well-known agent documents
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
/.well-known/oauth-authorization-server
  Content-Type: application/json; charset=utf-8
/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8
/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8

# MCP manifest (latest pointer) — JSON
/.well-known/mcp/manifest.json
  Content-Type: application/json; charset=utf-8

# Detached ECDSA P-256 signature — raw DER bytes (binary; the adapter verifies these exact bytes).
/.well-known/mcp/manifest.json.sig
  Content-Type: application/octet-stream
# Human-readable view of the same signature (base64) — renders in-browser, copy-pasteable.
/.well-known/mcp/manifest.json.sig.txt
  Content-Type: text/plain; charset=utf-8

# Immutable content-addressed blobs (spell bodies) — raw markdown
/blobs/sha256/*
  Content-Type: text/markdown; charset=utf-8

# Immutable manifest snapshots (one per version)
/manifests/*/manifest.json
  Content-Type: application/json; charset=utf-8
/manifests/*/manifest.json.sig
  Content-Type: application/octet-stream
/manifests/*/manifest.json.sig.txt
  Content-Type: text/plain; charset=utf-8
