{
  "name": "datamancy.dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source for datamancy.dev — the grimoire published as raw markdown + hash-verified MCP manifest.",
  "scripts": {
    "grimoire:regen": "node scripts/generate-grimoire-skill.mjs",
    "readme:regen": "node scripts/generate-readme-catalog.mjs",
    "docs:regen": "npm run grimoire:regen && npm run readme:regen",
    "check:docs": "node scripts/generate-grimoire-skill.mjs --check && node scripts/generate-readme-catalog.mjs --check",
    "manifest:generate": "node scripts/generate-manifest.mjs",
    "manifest:sign": "node scripts/sign-manifest.mjs",
    "manifest:publish": "npm run docs:regen && npm run manifest:generate && npm run manifest:sign",
    "ship": "node scripts/publish.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watmin/datamancy.dev.git"
  },
  "homepage": "https://datamancy.dev",
  "license": "MIT"
}
